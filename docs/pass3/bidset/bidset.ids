        <specification name="SHGC (window)" ifcVersion="IFC4" identifier="shgc/IFCWINDOW" description="IFC4 standard">
            <applicability minOccurs="0" maxOccurs="unbounded">
                <entity>
                    <name>
                        <simpleValue>IFCWINDOW</simpleValue>
                    </name>
