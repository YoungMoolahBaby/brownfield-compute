<?xml version='1.0' encoding='utf-8'?>
<ids xmlns="http://standards.buildingsmart.org/IDS" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://standards.buildingsmart.org/IDS http://standards.buildingsmart.org/IDS/1.0/ids.xsd">
    <info>
        <title>Windows and doors in a bid set (brownfield-compute pass 3f)</title>
        <version>0.1</version>
        <description>What a supplier needs to price a window or door, as requirements an IFC model can be checked against. Properties named BidSet_ are ours, where IFC4 has no standard one.</description>
        <purpose>bidding</purpose>
        <milestone>bid set</milestone>
    </info>
    <specifications>
        <specification name="type mark (window)" ifcVersion="IFC4" identifier="type/IFCWINDOW" description="IFC4 standard">
            <applicability minOccurs="0" maxOccurs="unbounded">
                <entity>
                    <name>
                        <simpleValue>IFCWINDOW</simpleValue>
                    </name>
                </entity>
            </applicability>
            <requirements>
                <property cardinality="required">
                    <propertySet>
                        <simpleValue>Pset_WindowCommon</simpleValue>
                    </propertySet>
                    <baseName>
                        <simpleValue>Reference</simpleValue>
                    </baseName>
                </property>
            </requirements>
        </specification>
        <specification name="type mark (door)" ifcVersion="IFC4" identifier="type/IFCDOOR" description="IFC4 standard">
            <applicability minOccurs="0" maxOccurs="unbounded">
                <entity>
                    <name>
                        <simpleValue>IFCDOOR</simpleValue>
                    </name>
                </entity>
            </applicability>
            <requirements>
                <property cardinality="required">
                    <propertySet>
                        <simpleValue>Pset_DoorCommon</simpleValue>
                    </propertySet>
                    <baseName>
                        <simpleValue>Reference</simpleValue>
                    </baseName>
                </property>
            </requirements>
        </specification>
        <specification name="storey (window)" ifcVersion="IFC4" identifier="storey/IFCWINDOW" description="IFC4 standard">
            <applicability minOccurs="0" maxOccurs="unbounded">
                <entity>
                    <name>
                        <simpleValue>IFCWINDOW</simpleValue>
                    </name>
                </entity>
            </applicability>
            <requirements>
                <partOf relation="IFCRELCONTAINEDINSPATIALSTRUCTURE" cardinality="required">
                    <entity>
                        <name>
                            <simpleValue>IFCBUILDINGSTOREY</simpleValue>
                        </name>
                    </entity>
                </partOf>
            </requirements>
        </specification>
