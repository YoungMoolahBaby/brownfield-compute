        <specification name="U-factor within the code's limit (window)" ifcVersion="IFC4" identifier="u/IFCWINDOW" description="IFC4 standard">
            <applicability minOccurs="0" maxOccurs="unbounded">
                <entity>
                    <name>
                        <simpleValue>IFCWINDOW</simpleValue>
                    </name>
                </entity>
            </applicability>
            <requirements>
                <property dataType="IFCTHERMALTRANSMITTANCEMEASURE" cardinality="required">
                    <propertySet>
                        <simpleValue>Pset_WindowCommon</simpleValue>
                    </propertySet>
                    <baseName>
                        <simpleValue>ThermalTransmittance</simpleValue>
                    </baseName>
                    <value>
                        <xs:restriction base="xs:double">
                            <xs:maxInclusive value="1.704" fixed="false" />
                        </xs:restriction>
                    </value>
                </property>
            </requirements>
        </specification>
        <specification name="U-factor within the code's limit (door)" ifcVersion="IFC4" identifier="u/IFCDOOR+glazed" description="IFC4 standard">
