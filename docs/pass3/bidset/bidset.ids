        <specification name="frame colour outside (door)" ifcVersion="IFC4" identifier="colour_out/IFCDOOR+exterior" description="BidSet_ (ours: IFC's styles colour a drawing, not a product)">
            <applicability minOccurs="0" maxOccurs="unbounded">
                <entity>
                    <name>
                        <simpleValue>IFCDOOR</simpleValue>
                    </name>
