        <specification name="rough opening width (window)" ifcVersion="IFC4" identifier="ro_width/IFCWINDOW" description="BidSet_ (ours: IFC's opening element is the hole in the model; this is the size to frame)">
            <applicability minOccurs="0" maxOccurs="unbounded">
                <entity>
                    <name>
                        <simpleValue>IFCWINDOW</simpleValue>
                    </name>
                </entity>
            </applicability>
            <requirements>
                <property dataType="IFCLENGTHMEASURE" cardinality="required">
